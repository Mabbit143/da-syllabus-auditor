# Existing default: Meta analysis. Set baseten explicitly after credit/privacy checks.
MODEL_PROVIDER=meta
MODEL_API_KEY=
BASETEN_API_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Lets app/api/record-gaps write to policy_gaps after re-verifying quotes server-side.
# Set in Vercel only (Production/Preview env vars) — never in the browser, never printed, never in git.
SUPABASE_SERVICE_ROLE_KEY=
# Modal uses its authenticated CLI profile. Do not place Modal tokens in the browser.
